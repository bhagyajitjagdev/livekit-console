# Copy to .env and fill in:  cp .env.example .env

# The LiveKit server this console manages. Server-side only — never exposed
# to the browser.
#   wss://livekit.example.com          (self-hosted)
#   wss://<project>.livekit.cloud      (LiveKit Cloud)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Sign-in credentials. Required — the backend refuses to start without them.
AUTH_USERNAME=
AUTH_PASSWORD=

# Signs the session cookie. Generate one with:  openssl rand -hex 32
# Leave unset and one is generated per boot, which signs everyone out on
# every restart.
SESSION_SECRET=

# Set to true once TLS terminates in front of the app.
SESSION_SECURE=false
