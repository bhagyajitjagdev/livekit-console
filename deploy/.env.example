# Copy to .env and fill in. Everything here is read by docker compose.
#   cp .env.example .env

# Domain Caddy serves the console on. Must already point at this host —
# Caddy uses it to obtain the TLS certificate.
CONSOLE_DOMAIN=console.example.com

# --- LiveKit -----------------------------------------------------------
# The server this console manages. Never exposed to the browser.
#   wss://livekit.example.com        (self-hosted)
#   wss://<project>.livekit.cloud    (LiveKit Cloud)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Sign-in -----------------------------------------------------------
# Required. The container refuses to start without both.
AUTH_USERNAME=
AUTH_PASSWORD=

# Signs the session cookie. Any length — it is hashed to the required size.
# Leave empty and one is generated per boot, which signs everyone out on
# every restart. Generate one with:  openssl rand -hex 32
SESSION_SECRET=
